    {
      "id": "2064ef75-caab-5b1b-8b66-1d812dc004a4",
      "name": "Read Rolling Window",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        340,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH recent AS (\n  SELECT status FROM execution_log\n  WHERE workflow_key = $1\n  ORDER BY created_at DESC, id DESC\n  LIMIT $2\n)\nSELECT count(*)::int AS total,\n       count(*) FILTER (WHERE status = 'error')::int AS errors\nFROM recent;",
        "options": {
          "queryReplacement": "={{ $('Normalize Breaker Input').first().json.workflow_key }}, {{ $('Normalize Breaker Input').first().json.window_size }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "Circuit Breaker Postgres"
        }
      }
    },
    {
      "id": "68d094e7-4624-50c8-b47f-b52742cf0e36",
      "name": "Evaluate Error Rate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "var cfg = $('Normalize Breaker Input').first().json;\nvar row = $input.first().json || {};\nvar total = Number(row.total || 0);\nvar errors = Number(row.errors || 0);\nvar rate = total > 0 ? errors / total : 0;\nrate = Math.round(rate * 10000) / 10000;\nvar enough = total >= Number(cfg.min_samples);\nvar trip = enough && rate > Number(cfg.error_rate_threshold);\nreturn [{ json: {\n  workflow_key: cfg.workflow_key,\n  window_size: Number(cfg.window_size),\n  samples: total,\n  min_samples: Number(cfg.min_samples),\n  errors: errors,\n  error_rate: rate,\n  error_rate_threshold: Number(cfg.error_rate_threshold),\n  should_trip: trip,\n  reason: trip\n    ? ('error rate ' + rate + ' over ' + total + ' runs exceeds threshold ' + cfg.error_rate_threshold)\n    : (enough ? 'error rate within threshold'\n              : 'not enough samples yet (' + total + ' of ' + cfg.min_samples + ')')\n} }];\n"
      }
    },
