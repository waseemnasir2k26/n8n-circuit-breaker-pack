    {
      "id": "3eda8d49-6154-5ea6-8f94-f3840956b5fc",
      "name": "Record Execution Outcome",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        120,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO execution_log (workflow_key, execution_id, status, error_message)\nVALUES ($1, $2, $3, $4)\nRETURNING id, created_at;",
        "options": {
          "queryReplacement": "={{ $json.workflow_key }}, {{ $json.execution_id }}, {{ $json.status }}, {{ $json.error_message }}"
        }
      },
      "credentials": {
