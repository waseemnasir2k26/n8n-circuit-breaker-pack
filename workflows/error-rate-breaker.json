    {
      "id": "553a9db1-caf0-5e49-bd79-993e08380a75",
      "name": "Normalize Breaker Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -320,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function envStr(name, fallback) {\n  try {\n    var v = $env[name];\n    if (v === undefined || v === null || v === '') { return fallback; }\n    return String(v);\n  } catch (e) {\n    return fallback;\n  }\n}\nfunction pick(v, envName, fallback) {\n  if (v !== undefined && v !== null && v !== '') { return v; }\n  return envStr(envName, fallback);\n}\n\nvar out = [];\nvar items = $input.all();\nfor (var i = 0; i < items.length; i++) {\n  var j = items[i].json || {};\n  var mode = String(pick(j.mode, 'N8N_CB_UNUSED_MODE', 'check')).toLowerCase();\n  if (mode !== 'check' && mode !== 'record') {\n    throw new Error(\"mode must be 'check' or 'record', got: \" + mode);\n  }\n  var status = String(pick(j.status, 'N8N_CB_UNUSED_STATUS', 'success')).toLowerCase();\n  if (mode === 'record' && status !== 'success' && status !== 'error') {\n    throw new Error(\"status must be 'success' or 'error', got: \" + status);\n  }\n  var execId = j.execution_id;\n  if (execId === undefined || execId === null || execId === '') { execId = $execution.id; }\n  var win = Number(pick(j.window_size, 'N8N_CB_ERROR_WINDOW', '20'));\n  var minSamples = Number(pick(j.min_samples, 'N8N_CB_ERROR_MIN_SAMPLES', String(win)));\n  out.push({ json: {\n    mode: mode,\n    is_check: mode === 'check',\n    workflow_key: String(pick(j.workflow_key, 'N8N_CB_WORKFLOW_KEY', 'default')),\n    execution_id: String(execId),\n    status: status,\n    error_message: (j.error_message === undefined || j.error_message === null)\n      ? null : String(j.error_message).slice(0, 2000),\n    window_size: win,\n    min_samples: minSamples,\n    error_rate_threshold: Number(pick(j.error_rate_threshold, 'N8N_CB_ERROR_RATE_THRESHOLD', '0.5'))\n  } });\n}\nreturn out;\n"
      }
    },
