    {
      "id": "1a104dc4-f338-5acc-a2a5-d7e9b02145c8",
      "name": "Evaluate Breaker Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        -180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "var cfg = $('Normalize Breaker Input').first().json;\nvar rows = $input.all();\nvar row = rows.length > 0 ? (rows[0].json || {}) : {};\nvar state = String(row.state || 'closed');\nvar open = state === 'open';\nreturn [{ json: {\n  workflow_key: cfg.workflow_key,\n  breaker_state: state,\n  breaker_open: open,\n  tripped_at: row.tripped_at || null,\n  reason: open\n    ? ('circuit breaker is OPEN for ' + cfg.workflow_key + ': ' + (row.reason || 'no reason recorded') + ' (reset is manual - see README)')\n    : 'circuit breaker closed'\n} }];\n"
      }
    },
