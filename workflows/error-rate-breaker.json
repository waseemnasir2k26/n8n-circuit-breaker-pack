    {
      "id": "910b8ed1-a714-5992-9f52-8b8355a80023",
      "name": "Trip Breaker (Error Rate)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        1000,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO breaker_state (workflow_key, state, reason, tripped_at, tripped_by)\nVALUES ($1, 'open', $2, now(), $3)\nON CONFLICT (workflow_key) DO UPDATE\n  SET state = 'open', reason = EXCLUDED.reason, tripped_at = now(),\n      tripped_by = EXCLUDED.tripped_by, reset_at = NULL, updated_at = now()\nRETURNING workflow_key, state, reason, tripped_at;",
        "options": {
          "queryReplacement": "={{ $json.workflow_key }}, {{ $json.reason }}, error-rate-breaker"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "Circuit Breaker Postgres"
        }
      }
    },
    {
      "id": "8d408803-5860-56f6-859d-5ed736b32fa8",
      "name": "Build Breaker Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Build one alert payload. Wire the NEXT node to Slack / email / PagerDuty.\nvar j = $input.first().json || {};\nreturn [{ json: {\n  alert: true,\n  severity: 'critical',\n  module: 'error-rate-breaker',\n  workflow_key: j.workflow_key || 'unknown',\n  reason: j.reason || 'limit exceeded',\n  detail: j,\n  execution_id: $execution.id,\n  fired_at: new Date().toISOString()\n} }];\n"
      }
    },
