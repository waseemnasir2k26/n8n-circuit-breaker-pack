        "mode": "runOnceForAllItems",
        "jsCode": "function envStr(name, fallback) {\n  try {\n    var v = $env[name];\n    if (v === undefined || v === null || v === '') { return fallback; }\n    return String(v);\n  } catch (e) {\n    return fallback;\n  }\n}\nfunction pick(v, envName, fallback) {\n  if (v !== undefined && v !== null && v !== '') { return v; }\n  return envStr(envName, fallback);\n}\n\nreturn [{ json: {\n  workflow_key: envStr('N8N_CB_WORKFLOW_KEY', 'example-protected-agent'),\n  run_key: String($execution.id)\n} }];\n"
      }
    },
