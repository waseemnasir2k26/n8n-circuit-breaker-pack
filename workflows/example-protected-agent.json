      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Replace this node with your real LLM / AI Agent node.\n// It must emit: model, input_tokens, output_tokens, done.\n// Real LLM nodes return token usage on the response - map that here, do not guess.\nvar cfg = $('Run Config').first().json;\nvar step = Number($('Charge Iteration Budget').first().json.iterations || 1);\nvar done = step >= 3;\nreturn [{ json: {\n  workflow_key: cfg.workflow_key,\n  run_key: cfg.run_key,\n  step: step,\n  model: 'gpt-4o-mini',\n  input_tokens: 1200,\n  output_tokens: 300,\n  done: done,\n  answer: done ? 'agent finished' : 'agent needs another turn'\n} }];\n"
      }
